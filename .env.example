# Monad RPC — dRPC example
MONAD_RPC_URL=https://lb.drpc.live/monad-mainnet/YOUR_DRPC_API_KEY

# Wallet private key that signs buyKeys (your player wallet)
PRIVATE_KEY=0x...

# CodenameSYBIL game contract on Monad mainnet
CONTRACT_ADDRESS=0x1BCBC2f2Ea5262a8E410B8B03bB2b994b43A76bb

# Hardhat artifact or plain ABI JSON array
CONTRACT_ABI_PATH=abi/ABI.json

# timer() = round end timestamp; timer_expiry converts to seconds remaining
READ_FUNCTION=timer
READ_MODE=timer_expiry

BUY_FUNCTION=buyKeys
BUY_TEAM=0
REFERRAL_ROUTE=optimum

# Buy when <= 2 minutes remain, unless our wallet is already lastBuyer
TRIGGER_SECONDS=120
POLL_INTERVAL_MS=5000

# auto = baseKeyPrice + keysSold * priceIncreasePerKey (+ PRICE_BUFFER_BPS)
BUY_VALUE_MON=auto
PRICE_BUFFER_BPS=200

# true = buy again if someone snipes us; false = one buy per bot run
ALLOW_REPEAT_BUY=true
PORT=3000
